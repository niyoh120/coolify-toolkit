# --- Coolify API (required) ---
# Base URL of your Coolify instance, e.g. https://coolify.example.com
COOLIFY_BASE_URL=
# Coolify API token (Team API). Server-side only; never exposed to the web build.
COOLIFY_API_KEY=
# Set to "false" only for self-signed internal setups. Default "true".
COOLIFY_VERIFY_TLS=true

# --- Coolify resources always excluded from management (comma-separated UUIDs) ---
# Toolkit itself, databases, reverse proxies etc.
EXCLUDED_RESOURCE_UUIDS=

# --- Storage ---
# SQLite database file location (directory must exist / be a mounted volume).
DATABASE_PATH=./data/toolkit.db
# Optional registry read-only credentials JSON: {"ghcr.io":{"username":"x","password":"y"}}
REGISTRY_CREDENTIALS_FILE=

# --- HTTP server ---
PORT=8080
# Public origin (scheme://host[:port]) used for same-origin write protection and links.
# When unset, same-origin is derived from the incoming Host header.
PUBLIC_ORIGIN=

# --- Apprise API notifications (optional) ---
# Persistent-config mode: POST {APPRISE_API_URL}/notify/{APPRISE_CONFIG_KEY}
APPRISE_API_URL=
APPRISE_CONFIG_KEY=
# Tag filter for channel selection. REQUIRED for apprise-api v2.0.0 in
# 公开/已锁定 access mode (tagless stateful notify is rejected with HTTP 400);
# optional in 用户 mode or when all configured channels are untagged.
APPRISE_TAG=
# HTTP Basic credentials for 已锁定/用户 access modes. APPRISE_USER is optional
# (apprise-api supports password-only admin accounts). Leave both empty in
# 公开 mode. Server-side only; never exposed to the web build.
APPRISE_USER=
APPRISE_PASSWORD=

# --- Update executor ---
# Global concurrent deployments (phase 1: keep at 1).
DEPLOY_CONCURRENCY=1

# 调度（同步/检查周期、时区、资源级覆盖）存于数据库，在设置页与资源详情页配置。
# 镜像检查默认每天 0 点。
# Optional GitHub token (read:packages) to show GHCR tag update times
# GITHUB_TOKEN=
